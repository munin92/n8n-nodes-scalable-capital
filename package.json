{
  "name": "@munin92/n8n-nodes-scalable-capital",
  "version": "1.0.4",
  "description": "n8n community node for Scalable Capital via its official MCP endpoint. Read-only by design.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "scalable-capital",
    "mcp",
    "finance",
    "broker"
  ],
  "license": "MIT",
  "homepage": "https://github.com/munin92/n8n-nodes-scalable-capital",
  "author": {
    "name": "munin92",
    "email": "lippitz.marian@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munin92/n8n-nodes-scalable-capital.git"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/copy-icons.mjs",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run build && npm run lint && npm test",
    "release": "semantic-release"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ScalableCapitalMcpApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ScalableCapital/ScalableCapital.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.30.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.10.0",
    "eslint": "9.29.0",
    "n8n-workflow": "*",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
